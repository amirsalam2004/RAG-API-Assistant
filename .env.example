# ============================================
# Vector Database (Optional - defaults shown)
# ============================================

# Path where ChromaDB stores vector data on disk
# Default: ./chroma_db
VECTOR_DB_PATH=./chroma_db

# Name of the collection in ChromaDB
# Default: api_docs
COLLECTION_NAME=api_docs

# Sentence transformer model for embeddings
# Default: all-MiniLM-L6-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================
# OpenRouter API (Required)
# ============================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================
# Swagger URL (Required)                            
# ============================================
SWAGGER_URL=your_swagger_url_here

OPENAPI_SPEC_URL=your_openapi_spec_url_here